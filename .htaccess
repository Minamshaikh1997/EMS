Options -Indexes
ServerSignature Off

<FilesMatch "^(setup.*|role_setup|clear_employees|clear_departments|list_admins|dashboard_old|diagnose.*|.*debug.*|test.*|check.*|quick.*|reset.*|admin_reset_password|fix.*|hash.*|seed_departments.*|install_permissions|run_.*|verify_.*|employee_leave_systemreset.*)\.php$">
    Require all denied
</FilesMatch>

<FilesMatch "(^\..*|\.(bat|sql|md|txt|docx|json|log|ini|ya?ml|ps1|sh|bak))$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
